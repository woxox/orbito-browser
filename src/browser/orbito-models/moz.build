# Browsing recall's embedding model, staged by scripts/recall-model.py,
# installed as browser/orbito-models/ (resource:///orbito-models/). Builds
# without a staged model ship nothing here, and recall searches by keywords
# only.

FINAL_TARGET_FILES["orbito-models"] += [
    "/../dist/recall-model/**",
]
