# Browser branding
ac_add_options --with-app-name=${binName}
ac_add_options --with-app-basename=Orbito

export MOZ_APP_BASENAME=Orbito
export MOZ_USER_DIR="${name}"
export MOZ_BRANDING_DIRECTORY=${brandingDir}
export MOZ_OFFICIAL_BRANDING_DIRECTORY=${brandingDir}

# Reverse-DNS prefix of the macOS bundle IDs: dev.woxox.orbito for the app,
# dev.woxox.plugincontainer for its helper. Changing it after a release breaks
# updates, keychain items and TCC grants, and the passkey entitlement is
# granted to this App ID.
ac_add_options --with-distribution-id=dev.woxox

# Uncomment if builds are too resource hungry
# mk_add_options MOZ_MAKE_FLAGS="-j4"

# Misc
# No MOZ_SOURCE_CHANGESET: it lands in config/autoconf.mk, which every object
# depends on, so each new commit rebuilt everything. The build stamps the
# Firefox source's sourcestamp.txt instead.
export MOZ_INCLUDE_SOURCE_INFO=1

ac_add_options --enable-application=browser

# Dev builds: let mach download toolchains (clang, rust, etc.)
ac_add_options --enable-bootstrap

if test "$ORBITO_RELEASE"; then
  ac_add_options --enable-optimize
  ac_add_options --enable-release
  ac_add_options --disable-debug
  ac_add_options --disable-debug-symbols
  ac_add_options --disable-tests
  ac_add_options --disable-crashreporter
  # A new version lands in mozilla-config.h and config/autoconf.mk, so each
  # release recompiles every object; sccache serves all but the few that use it.
  ac_add_options --with-ccache=sccache
  # One job per core of the build server. mach otherwise caps the jobs at one
  # per GiB of RAM, which leaves cores idle on the server.
  mk_add_options MOZ_PARALLEL_BUILD=$(getconf _NPROCESSORS_ONLN)
  mk_add_options MOZILLA_OFFICIAL=1
  export MOZILLA_OFFICIAL=1
else
  # The release tarball defaults to --enable-release, which builds Rust with
  # codegen-units=1 (gkrust alone takes 15+ min single-threaded).
  ac_add_options --disable-release
  # Keep dev builds' profiles apart from the release app's: application.ini's
  # Profile puts them under "Orbito Dev" instead of "Orbito" (e.g.
  # ~/Library/Application Support/Orbito Dev on macOS).
  export ORBITO_APP_PROFILE="Orbito Dev"
fi

ac_add_options --with-unsigned-addon-scopes=app,system

# No telemetry
mk_add_options MOZ_DATA_REPORTING=
mk_add_options MOZ_SERVICES_HEALTHREPORT=
mk_add_options MOZ_TELEMETRY_REPORTING=

# Allow loading unsigned extensions
export MOZ_REQUIRE_SIGNING=
mk_add_options MOZ_REQUIRE_SIGNING=
